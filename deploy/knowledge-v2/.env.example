# Copy to .env on the local worker host; keep credentials out of Git.
QDRANT_IMAGE=qdrant/qdrant@sha256:12364fe851b9f17356fc88189fc06d1b521262e04659ec7345975b00c9246a10
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_PATH=/opt/normcontrol/models
KNOWLEDGE_DATA_PATH=/opt/normcontrol/data

# Enable the optional worker only when the portal's v2 API is ready.
KNOWLEDGE_PORTAL_URL=https://your-portal.example/normcontol/api/v2
KNOWLEDGE_WORKER_TOKEN=
# Optional trusted llama.cpp endpoint for explicitly requested review suggestions.
# In Docker, localhost refers to the container; use an accessible trusted host.
KNOWLEDGE_LLM_ENDPOINT=
KNOWLEDGE_LLM_API_KEY=
# The server must actually load the selected model. Pin a file revision/digest; do not reuse it after changing weights.
KNOWLEDGE_LLM_MODEL=local-qwen
KNOWLEDGE_LLM_REVISION=
# Contextual screening after extraction; uncertain cards remain expert candidates.
KNOWLEDGE_QUALITY_SCREENING=1
# Vision may use the same trusted Qwen3.8 server with its compatible mmproj, or a separate trusted endpoint.
KNOWLEDGE_VISION_MODEL=local-qwen
KNOWLEDGE_VISION_REVISION=

# Optional isolated portal profile. The live VPS keeps its own deployment.
APP_DEBUG=0
APP_SECRET=
APP_HOSTS=localhost,127.0.0.1,knowledge-portal
APP_ORIGINS=http://127.0.0.1:8110
