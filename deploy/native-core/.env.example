# Copy to the deployment directory as .env; set actual endpoints before starting.
NORMCONTROL_CORE_IMAGE=normcontrol/native-core:1.0.0
NORMCONTROL_CORE_DATA=/opt/normcontrol/native-core/data
NORMCONTROL_CORE_SECRETS=/opt/normcontrol/native-core/secrets
# Certificate SAN must cover gateway and the actual Windows host endpoint.
NORMCONTROL_QUEUE_ENDPOINT=https://gateway:8098
NORMCONTROL_HOST_ENDPOINT=https://192.0.2.10:8123
# For Windows forwarding over the WSL address, explicitly change both to 0.0.0.0
# and restrict the WSL/Windows firewall and gateway client allowlist.
NORMCONTROL_QUEUE_BIND=127.0.0.1
NORMCONTROL_API_BIND=127.0.0.1